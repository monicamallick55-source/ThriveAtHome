{
  "name": "thrive-at-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "./scripts/run-tests.sh all",
    "test:env": "npx tsx scripts/check-env.ts",
    "test:db": "npx tsx tests/db/run-assertions.ts",
    "test:api": "npx tsx tests/api/fhir.test.ts && npx tsx tests/api/cron.test.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:quick": "npx playwright test tests/e2e/public-routes.spec.ts tests/e2e/feature-flags.spec.ts",
    "test:e2e:member": "npx playwright test tests/e2e/member-pages.spec.ts tests/e2e/family-portal.spec.ts tests/e2e/navigator-portal.spec.ts",
    "test:e2e:auth": "npx playwright test tests/e2e/auth-roles.spec.ts",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "date-fns": "^4.1.0",
    "focus-trap-react": "^12.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.67.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.37.0",
    "retell-client-js-sdk": "^2.0.0",
    "retell-sdk": "^6.1.1",
    "stripe": "^22.1.1",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "supabase": "^2.122.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.1",
    "typescript": "^5"
  }
}
