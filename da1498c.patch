diff --git a/supabase/migrations/129_home_safety_member_tables.sql b/supabase/migrations/129_home_safety_member_tables.sql
new file mode 100644
index 0000000..b61d39a
--- /dev/null
+++ b/supabase/migrations/129_home_safety_member_tables.sql
@@ -0,0 +1,43 @@
+-- 129_home_safety_member_tables.sql
+-- Member-facing home safety assessment tables (G6.1)
+-- These are distinct from the volunteer safety program tables in 097_home_safety_program.sql
+
+CREATE TABLE IF NOT EXISTS home_safety_profiles (
+  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  member_id       uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  org_id          uuid REFERENCES orgs(id) ON DELETE SET NULL,
+  home_type       text NOT NULL DEFAULT 'unknown',
+  floors          int  NOT NULL DEFAULT 1,
+  earthquake_zone text,
+  emergency_contact_name  text,
+  emergency_contact_phone text,
+  enrolled_at     timestamptz NOT NULL DEFAULT now(),
+  updated_at      timestamptz NOT NULL DEFAULT now(),
+  UNIQUE(member_id)
+);
+
+ALTER TABLE home_safety_profiles ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "hsp_own" ON home_safety_profiles;
+CREATE POLICY "hsp_own" ON home_safety_profiles FOR ALL
+  USING (member_id IN (SELECT id FROM members WHERE supabase_auth_id = auth.uid()));
+
+CREATE TABLE IF NOT EXISTS home_safety_checklist_items (
+  id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  member_id   uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  org_id      uuid REFERENCES orgs(id) ON DELETE SET NULL,
+  category    text NOT NULL,
+  title       text NOT NULL,
+  priority    text NOT NULL DEFAULT 'medium' CHECK (priority IN ('high','medium','low')),
+  completed   boolean NOT NULL DEFAULT false,
+  completed_at timestamptz,
+  created_at  timestamptz NOT NULL DEFAULT now(),
+  updated_at  timestamptz NOT NULL DEFAULT now()
+);
+
+ALTER TABLE home_safety_checklist_items ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS "hsci_own" ON home_safety_checklist_items;
+CREATE POLICY "hsci_own" ON home_safety_checklist_items FOR ALL
+  USING (member_id IN (SELECT id FROM members WHERE supabase_auth_id = auth.uid()));
+
+CREATE INDEX IF NOT EXISTS idx_hsp_member ON home_safety_profiles(member_id);
+CREATE INDEX IF NOT EXISTS idx_hsci_member ON home_safety_checklist_items(member_id);
