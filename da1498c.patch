+    color: 'red',
+  },
+  {
+    icon: '💻',
+    title: 'Online & Email Phishing',
+    description: 'Fake emails, websites, or pop-ups that look like trusted companies (banks, Amazon, Medicare) trying to steal passwords or financial information.',
+    tips: ['Look for misspellings in email addresses and website URLs', 'Never click links in unexpected emails — go directly to the website', 'Your navigator can help you check if a message is legitimate'],
+    color: 'orange',
+  },
+  {
+    icon: '❤️',
+    title: 'Romance & Friendship Scams',
+    description: 'Scammers build emotional relationships online over weeks or months before asking for money, often claiming an emergency.',
+    tips: ['Never send money to someone you have only met online', 'Be cautious if someone cannot meet in person or video chat', 'Talk to your navigator or a trusted person before sending any money'],
+    color: 'rose',
+  },
+  {
+    icon: '🏠',
+    title: 'Home Repair & Contractor Fraud',
+    description: 'Door-to-door contractors offering unusually cheap repairs, requiring large upfront payment, then disappearing or doing poor work.',
+    tips: ['Always get three quotes for major repairs', 'Never pay the full amount upfront — a small deposit is normal', 'Ask for license numbers and check references'],
+    color: 'amber',
+  },
+  {
+    icon: '💊',
+    title: 'Medicare & Health Insurance Fraud',
+    description: 'Scammers offering "free" equipment, tests, or services in exchange for your Medicare number, then billing Medicare for things you never received.',
+    tips: ['Guard your Medicare card like a credit card', 'Review your Medicare Summary Notice for charges you don\'t recognize', 'Report suspected fraud to 1-800-MEDICARE'],
+    color: 'blue',
+  },
+  {
+    icon: '🎁',
+    title: 'Lottery & Prize Scams',
+    description: 'Notifications that you have won a prize or lottery that require an upfront fee or taxes to be paid before receiving your "winnings."',
+    tips: ['You cannot win a lottery you didn\'t enter', 'Legitimate prizes never require upfront payment', 'If it sounds too good to be true, it is'],
+    color: 'purple',
+  },
+]
+
+export default async function FraudProtectionPage() {
+  const supabase = await createClient()
+  const { data: { user } } = await supabase.auth.getUser()
+  if (!user) redirect('/login')
+
+  const { data: member } = await supabase
+    .from('members')
+    .select('id, org_id')
+    .eq('supabase_auth_id', user.id)
+    .maybeSingle()
+
+  if (!member) redirect('/dashboard')
+
+  return (
+    <div className="max-w-3xl mx-auto px-4 py-8">
+      <div className="mb-8">
+        <h1 className="text-2xl font-bold text-gray-900">Fraud &amp; Scam Protection</h1>
+        <p className="text-gray-500 mt-1">
+          Stay informed and protected. Your navigator is here to help you spot and report scams.
+        </p>
+      </div>
+
+      {/* Emergency banner */}
+      <div className="mb-8 rounded-xl bg-red-50 border border-red-200 p-5">
+        <div className="flex items-start gap-3">
+          <span className="text-2xl flex-shrink-0">🚨</span>
+          <div>
+            <p className="font-semibold text-red-900">Think you are being scammed right now?</p>
+            <p className="text-sm text-red-700 mt-1">
+              Hang up or stop the conversation. Do not send money. Call your navigator immediately,
+              or contact the FTC at <strong>ReportFraud.ftc.gov</strong> or 1-877-382-4357.
+            </p>
+          </div>
+        </div>
+      </div>
+
+      {/* Scam type cards */}
+      <div className="space-y-4">
+        <h2 className="text-sm font-semibold text-gray-700 uppercase tracking-wide">Common scams to watch for</h2>
+        {SCAM_TYPES.map(scam => (
+          <div key={scam.title} className="rounded-xl border border-gray-200 bg-white p-5">
+            <div className="flex items-start gap-4">
+              <span className="text-2xl flex-shrink-0">{scam.icon}</span>
+              <div className="flex-1 min-w-0">
+                <p className="font-semibold text-gray-900">{scam.title}</p>
+                <p className="text-sm text-gray-600 mt-1">{scam.description}</p>
+                <ul className="mt-3 space-y-1">
+                  {scam.tips.map(tip => (
+                    <li key={tip} className="flex items-start gap-2 text-sm text-gray-700">
+                      <span className="text-green-500 flex-shrink-0 mt-0.5">✓</span>
+                      {tip}
+                    </li>
+                  ))}
+                </ul>
+              </div>
+            </div>
+          </div>
+        ))}
+      </div>
+
+      {/* Report section */}
+      <div className="mt-8 rounded-xl border border-indigo-200 bg-indigo-50 p-6">
+        <h2 className="font-semibold text-indigo-900 mb-2">Report a suspected scam</h2>
+        <p className="text-sm text-indigo-700 mb-4">
