+/**
+ * app/api/family-members/route.ts — List family members linked to current member
+ * GET /api/family-members — returns { family_members: FamilyMember[] }
+ */
+import { NextResponse } from 'next/server'
+import { createClient } from '@/lib/supabase/server'
+
+export async function GET() {
+  try {
+    const supabase = await createClient()
+    const { data: { user } } = await supabase.auth.getUser()
+    if (!user) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
+
+    // Look up member row
+    const { data: member } = await supabase
+      .from('members')
+      .select('id')
+      .eq('supabase_auth_id', user.id)
+      .maybeSingle()
+
+    if (!member) return NextResponse.json({ family_members: [] })
+
+    const { data: fms, error } = await supabase
+      .from('family_members')
+      .select('id, name, relationship, email, phone, can_view_care_info, can_receive_gifts')
+      .eq('member_id', member.id)
+      .order('name')
+
+    if (error) return NextResponse.json({ family_members: [] })
+
+    return NextResponse.json({ family_members: fms ?? [] })
+  } catch (err: any) {
+    return NextResponse.json({ family_members: [] })
+  }
+}
