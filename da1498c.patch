+          <a
+            href="/dashboard/navigator"
+            className="inline-flex items-center gap-1.5 rounded-lg border border-indigo-300 bg-white px-4 py-2 text-sm font-medium text-indigo-700 hover:bg-indigo-50 transition-colors"
+          >
+            Contact my navigator
+          </a>
+        </div>
+      </div>
+    </div>
+  )
+}
