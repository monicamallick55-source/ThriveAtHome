From 2e2cc03cce46591a8db40f0012f1ee18d2ce255a Mon Sep 17 00:00:00 2001
From: monicamallick55-source <monicamallick55@gmail.com>
Date: Wed, 21 Oct 2026 00:04:45 +0000
Subject: [PATCH 31/39] adding migration sql

---
 ...igrations--20261020_notification_queue.sql | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 supabase/migrations/supabase--migrations--20261020_notification_queue.sql

diff --git a/supabase/migrations/supabase--migrations--20261020_notification_queue.sql b/supabase/migrations/supabase--migrations--20261020_notification_queue.sql
new file mode 100644
index 0000000..eca46bf
--- /dev/null
+++ b/supabase/migrations/supabase--migrations--20261020_notification_queue.sql
@@ -0,0 +1,47 @@
+-- Migration: notification_queue
+-- Stores outbound SMS/email/push messages queued by the auto-scheduler
+-- and other automation flows. A cron job or edge function drains the
+-- queue and dispatches via Twilio / Resend / FCM.
+
+create table if not exists notification_queue (
+  id           uuid primary key default gen_random_uuid(),
+  created_at   timestamptz not null default now(),
+  scheduled_at timestamptz not null default now(),
+  sent_at      timestamptz,
+  failed_at    timestamptz,
+  retry_count  int not null default 0,
+
+  member_id    uuid references members(id) on delete cascade,
+  channel      text not null check (channel in ('sms', 'email', 'push')),
+
+  -- SMS fields
+  phone        text,
+  -- Email fields
+  email        text,
+  subject      text,
+  -- Push fields
+  device_token text,
+
+  -- Common payload
+  message      text not null,
+  metadata     jsonb default '{}',
+
+  status       text not null default 'pending'
+               check (status in ('pending', 'sent', 'failed', 'cancelled'))
+);
+
+-- Index for the drain cron — pending messages ordered by scheduled_at
+create index if not exists notification_queue_pending_idx
+  on notification_queue (scheduled_at asc)
+  where status = 'pending';
+
+-- Index for member history
+create index if not exists notification_queue_member_idx
+  on notification_queue (member_id, created_at desc);
+
+-- RLS: service role (server-side) bypasses RLS for all writes.
+-- Authenticated users cannot read notification_queue from the client —
+-- all access is via server-side admin client only.
+alter table notification_queue enable row level security;
+
+-- No client-side read policy — admin client uses service role key which bypasses RLS.
-- 
