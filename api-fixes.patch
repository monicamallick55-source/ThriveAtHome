+-- 097_home_safety_program.sql
+-- G6.1 — Home Safety & Earthquake Preparedness Program
+-- Modelled on Foster City Village's 2025-2026 programme
+
+-- Safety Programmes (per org, or ThriveAtHome-run when org_id IS NULL)
+CREATE TABLE IF NOT EXISTS safety_programs (
+  id                          uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at                  timestamptz DEFAULT now() NOT NULL,
+  org_id                      uuid,  -- references org; FK omitted until org table is confirmed
+  name                        text NOT NULL,
+  program_year                text NOT NULL,            -- e.g. '2026'
+  description                 text,
+  eligibility                 jsonb NOT NULL DEFAULT '{}', -- e.g. {"org_tiers":["full"]}
+  capacity_households         integer NOT NULL DEFAULT 20,
+  enrollment_open             boolean NOT NULL DEFAULT true,
+  starts_on                   date,
+  ends_on                     date,
+  free_item_budget_cents      integer NOT NULL DEFAULT 0,
+  subsidy_per_home_cents      integer NOT NULL DEFAULT 0,
+  contractor_partner_id       uuid REFERENCES community_partners(id),
+  income_referral_partner_id  uuid REFERENCES community_partners(id),
+  sponsors                    jsonb NOT NULL DEFAULT '[]', -- [{name, logo_url, amount_cents}]
+  created_by                  uuid REFERENCES family_members(id)
+);
+ALTER TABLE safety_programs ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "sp_read"  ON safety_programs FOR SELECT USING (is_staff() OR org_id IS NULL OR EXISTS (
+  SELECT 1 FROM org_memberships om WHERE om.org_id = safety_programs.org_id AND om.member_id = ANY(acting_member_ids())
+));
+CREATE POLICY "sp_staff_write" ON safety_programs FOR ALL USING (is_staff());
+
+-- Enrolments — one per household per programme
+CREATE TABLE IF NOT EXISTS safety_program_enrollments (
+  id                 uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at         timestamptz DEFAULT now() NOT NULL,
+  program_id         uuid NOT NULL REFERENCES safety_programs(id) ON DELETE CASCADE,
+  member_id          uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  home_type          text NOT NULL DEFAULT 'single_family'
+                     CHECK (home_type IN ('single_family','condo','townhouse','apartment','mobile_home','other')),
+  comments           text,
+  status             text NOT NULL DEFAULT 'applied'
+                     CHECK (status IN ('applied','waitlisted','enrolled','training_scheduled','inspected',
+                                       'proposal_sent','work_in_progress','complete','declined','withdrawn')),
+  volunteer_id       uuid REFERENCES members(id),
+  income_qualified   boolean,                           -- self-attested; partner verifies
+  consent_terms_at   timestamptz,
+  UNIQUE (program_id, member_id)
+);
+ALTER TABLE safety_program_enrollments ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "spe_own_or_staff" ON safety_program_enrollments FOR ALL
+  USING (member_id = ANY(acting_member_ids()) OR is_staff() OR
+         volunteer_id = ANY(acting_member_ids()))
+  WITH CHECK (member_id = ANY(acting_member_ids()) OR is_staff());
+
+-- Volunteers assigned to programmes
+CREATE TABLE IF NOT EXISTS safety_program_volunteers (
+  id               uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at       timestamptz DEFAULT now() NOT NULL,
+  program_id       uuid NOT NULL REFERENCES safety_programs(id) ON DELETE CASCADE,
+  volunteer_id     uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  max_households   integer NOT NULL DEFAULT 5,
+  trained_at       timestamptz,
+  UNIQUE (program_id, volunteer_id)
+);
+ALTER TABLE safety_program_volunteers ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "spv_read" ON safety_program_volunteers FOR SELECT
+  USING (is_staff() OR volunteer_id = ANY(acting_member_ids()));
+CREATE POLICY "spv_staff_write" ON safety_program_volunteers FOR ALL USING (is_staff());
+
+-- Home Safety Checks (inspection visits)
+CREATE TABLE IF NOT EXISTS home_safety_checks (
+  id                      uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at              timestamptz DEFAULT now() NOT NULL,
+  enrollment_id           uuid NOT NULL REFERENCES safety_program_enrollments(id) ON DELETE CASCADE,
+  member_id               uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  mode                    text NOT NULL DEFAULT 'in_person'
+                          CHECK (mode IN ('in_person','virtual')),
+  scheduled_at            timestamptz,
+  completed_at            timestamptz,
+  assessor_volunteer_id   uuid REFERENCES members(id),
+  assessor_family_member_id uuid REFERENCES family_members(id),
+  status                  text NOT NULL DEFAULT 'scheduled'
+                          CHECK (status IN ('scheduled','in_progress','completed','cancelled')),
+  report_pdf_path         text
+);
+ALTER TABLE home_safety_checks ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "hsc_own_or_staff" ON home_safety_checks FOR ALL
+  USING (member_id = ANY(acting_member_ids()) OR is_staff() OR
+         assessor_volunteer_id = ANY(acting_member_ids()))
+  WITH CHECK (member_id = ANY(acting_member_ids()) OR is_staff() OR
+              assessor_volunteer_id = ANY(acting_member_ids()));
+
+-- Checklist items per check
+CREATE TABLE IF NOT EXISTS home_safety_items (
+  id          uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at  timestamptz DEFAULT now() NOT NULL,
+  check_id    uuid NOT NULL REFERENCES home_safety_checks(id) ON DELETE CASCADE,
+  room        text NOT NULL,
+  item_key    text NOT NULL,
+  result      text NOT NULL DEFAULT 'na'
+              CHECK (result IN ('ok','concern','na')),
+  note        text,
+  photo_path  text
+);
+ALTER TABLE home_safety_items ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "hsi_via_check" ON home_safety_items FOR ALL
+  USING (EXISTS (
+    SELECT 1 FROM home_safety_checks hsc WHERE hsc.id = home_safety_items.check_id
+    AND (hsc.member_id = ANY(acting_member_ids()) OR is_staff() OR
+         hsc.assessor_volunteer_id = ANY(acting_member_ids()))
+  ));
+
+-- Work tiers per programme (basic / enhanced)
+CREATE TABLE IF NOT EXISTS safety_work_tiers (
+  id           uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at   timestamptz DEFAULT now() NOT NULL,
+  program_id   uuid NOT NULL REFERENCES safety_programs(id) ON DELETE CASCADE,
+  tier_key     text NOT NULL CHECK (tier_key IN ('basic','enhanced')),
+  label        text NOT NULL,
+  description  text,
+  UNIQUE (program_id, tier_key)
+);
+ALTER TABLE safety_work_tiers ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "swt_read" ON safety_work_tiers FOR SELECT USING (true);
+CREATE POLICY "swt_staff_write" ON safety_work_tiers FOR ALL USING (is_staff());
+
+-- Proposals sent to member
+CREATE TABLE IF NOT EXISTS safety_proposals (
+  id                   uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at           timestamptz DEFAULT now() NOT NULL,
+  enrollment_id        uuid NOT NULL REFERENCES safety_program_enrollments(id) ON DELETE CASCADE,
+  tier_key             text NOT NULL CHECK (tier_key IN ('basic','enhanced')),
+  sent_at              timestamptz,
+  responded_at         timestamptz,
+  status               text NOT NULL DEFAULT 'draft'
+                       CHECK (status IN ('draft','sent','accepted_all','accepted_some','declined')),
+  total_free_cents     integer NOT NULL DEFAULT 0,
+  total_subsidy_cents  integer NOT NULL DEFAULT 0,
+  total_member_cents   integer NOT NULL DEFAULT 0
+);
+ALTER TABLE safety_proposals ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "sproposal_own_or_staff" ON safety_proposals FOR ALL
+  USING (EXISTS (
+    SELECT 1 FROM safety_program_enrollments spe
+    WHERE spe.id = safety_proposals.enrollment_id
+    AND (spe.member_id = ANY(acting_member_ids()) OR is_staff() OR
+         spe.volunteer_id = ANY(acting_member_ids()))
+  ));
+
+-- Proposal line items
+CREATE TABLE IF NOT EXISTS safety_proposal_lines (
+  id                              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at                      timestamptz DEFAULT now() NOT NULL,
+  proposal_id                     uuid NOT NULL REFERENCES safety_proposals(id) ON DELETE CASCADE,
+  item_key                        text NOT NULL,
+  description                     text NOT NULL,
+  route                           text NOT NULL DEFAULT 'contractor'
+                                  CHECK (route IN ('contractor','partner_referral','volunteer','member_diy')),
+  est_cost_cents                  integer NOT NULL DEFAULT 0,
+  contractor_discount_cents       integer NOT NULL DEFAULT 0,
+  subsidy_cents                   integer NOT NULL DEFAULT 0,
+  member_cost_cents               integer NOT NULL DEFAULT 0,
+  accepted                        boolean,                -- null = not yet decided
+  work_order_status               text NOT NULL DEFAULT 'not_started'
+                                  CHECK (work_order_status IN ('not_started','scheduled','done','verified')),
+  completed_at                    timestamptz,
+  verified_by_volunteer_at        timestamptz,
+  community_partner_referral_id   uuid REFERENCES partner_referrals(id)
+);
+ALTER TABLE safety_proposal_lines ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "spl_via_proposal" ON safety_proposal_lines FOR ALL
+  USING (EXISTS (
+    SELECT 1 FROM safety_proposals sp
+    JOIN safety_program_enrollments spe ON spe.id = sp.enrollment_id
+    WHERE sp.id = safety_proposal_lines.proposal_id
+    AND (spe.member_id = ANY(acting_member_ids()) OR is_staff() OR
+         spe.volunteer_id = ANY(acting_member_ids()))
+  ));
+
+-- Go-Bags per enrollment
+CREATE TABLE IF NOT EXISTS go_bags (
+  id                  uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at          timestamptz DEFAULT now() NOT NULL,
+  enrollment_id       uuid NOT NULL REFERENCES safety_program_enrollments(id) ON DELETE CASCADE,
+  delivered_at        timestamptz,
+  contents_checklist  jsonb NOT NULL DEFAULT '{}',
+  next_refresh_due    date
+);
+ALTER TABLE go_bags ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "gb_own_or_staff" ON go_bags FOR ALL
+  USING (EXISTS (
+    SELECT 1 FROM safety_program_enrollments spe
+    WHERE spe.id = go_bags.enrollment_id
+    AND (spe.member_id = ANY(acting_member_ids()) OR is_staff())
+  ));
+
+-- Emergency fridge magnets
+CREATE TABLE IF NOT EXISTS emergency_magnets (
+  id                uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at        timestamptz DEFAULT now() NOT NULL,
+  enrollment_id     uuid NOT NULL REFERENCES safety_program_enrollments(id) ON DELETE CASCADE,
+  generated_pdf_path text,
+  printed           boolean NOT NULL DEFAULT false,
+  delivered_at      timestamptz
+);
+ALTER TABLE emergency_magnets ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "em_own_or_staff" ON emergency_magnets FOR ALL
+  USING (EXISTS (
+    SELECT 1 FROM safety_program_enrollments spe
+    WHERE spe.id = emergency_magnets.enrollment_id
+    AND (spe.member_id = ANY(acting_member_ids()) OR is_staff())
+  ));
+
+-- Indexes for common lookups
+CREATE INDEX IF NOT EXISTS idx_spe_member ON safety_program_enrollments(member_id);
+CREATE INDEX IF NOT EXISTS idx_spe_volunteer ON safety_program_enrollments(volunteer_id);
+CREATE INDEX IF NOT EXISTS idx_hsc_enrollment ON home_safety_checks(enrollment_id);
+CREATE INDEX IF NOT EXISTS idx_hsi_check ON home_safety_items(check_id);
+CREATE INDEX IF NOT EXISTS idx_sp_enrollment ON safety_proposals(enrollment_id);
+CREATE INDEX IF NOT EXISTS idx_spl_proposal ON safety_proposal_lines(proposal_id);
diff --git a/supabase/migrations/098_home_sharing.sql b/supabase/migrations/098_home_sharing.sql
new file mode 100644
index 0000000..9228b83
--- /dev/null
+++ b/supabase/migrations/098_home_sharing.sql
@@ -0,0 +1,72 @@
+-- 098_home_sharing.sql
+-- G6.2 — Home Sharing Program
+-- Connects seniors who want to share their home with those seeking housing
+
+CREATE TYPE home_sharing_status AS ENUM (
+  'inquiring',      -- member submitted interest form
+  'screening',      -- navigator reviewing / background check in progress
+  'matched',        -- navigator has identified a potential match
+  'trial',          -- trial living arrangement in place
+  'active',         -- confirmed home share arrangement
+  'paused',         -- temporarily on hold
+  'closed'          -- arrangement ended or member withdrew
+);
+
+CREATE TYPE home_sharing_role AS ENUM ('host', 'seeker');
+
+CREATE TABLE IF NOT EXISTS home_sharing_referrals (
+  id                  uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at          timestamptz DEFAULT now() NOT NULL,
+  updated_at          timestamptz DEFAULT now() NOT NULL,
+  member_id           uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  role                home_sharing_role NOT NULL,  -- host or seeker
+  status              home_sharing_status NOT NULL DEFAULT 'inquiring',
+
+  -- Host details
+  home_description    text,               -- bedrooms, bathrooms, amenities
+  rent_expectation    text,               -- e.g. "$800/mo" or "services in lieu"
+  preferred_move_in   date,
+  house_rules         text,               -- pets, smoking, quiet hours, etc.
+
+  -- Seeker details
+  budget_description  text,               -- what they can afford
+  desired_location    text,               -- city/neighbourhood preference
+  move_in_by          date,
+
+  -- Shared fields
+  notes               text,               -- member's free-text notes
+  navigator_notes     text,               -- internal staff notes
+  matched_member_id   uuid REFERENCES members(id),  -- the other party when matched
+  navigator_id        uuid REFERENCES members(id),   -- assigned navigator
+  consent_shared_at   timestamptz,        -- when member consented to info sharing
+
+  CONSTRAINT home_sharing_referrals_role_check CHECK (
+    (role = 'host' AND home_description IS NOT NULL) OR
+    (role = 'seeker' AND desired_location IS NOT NULL) OR
+    (notes IS NOT NULL)  -- allow partial submissions
+  )
+);
+
+-- RLS
+ALTER TABLE home_sharing_referrals ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY "member sees own home sharing referral"
+  ON home_sharing_referrals FOR SELECT
+  USING (member_id = ANY(acting_member_ids()));
+
+CREATE POLICY "staff sees all home sharing referrals"
+  ON home_sharing_referrals FOR ALL
+  USING (is_staff());
+
+-- updated_at trigger
+CREATE OR REPLACE FUNCTION touch_home_sharing_referral()
+  RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN NEW.updated_at = now(); RETURN NEW; END; $$;
+
+CREATE TRIGGER home_sharing_referrals_updated
+  BEFORE UPDATE ON home_sharing_referrals
+  FOR EACH ROW EXECUTE FUNCTION touch_home_sharing_referral();
+
+-- Index
+CREATE INDEX IF NOT EXISTS home_sharing_referrals_member_idx ON home_sharing_referrals(member_id);
+CREATE INDEX IF NOT EXISTS home_sharing_referrals_status_idx ON home_sharing_referrals(status);
diff --git a/supabase/migrations/099_encore_careers.sql b/supabase/migrations/099_encore_careers.sql
new file mode 100644
index 0000000..dda82a4
--- /dev/null
+++ b/supabase/migrations/099_encore_careers.sql
@@ -0,0 +1,127 @@
+-- 099_encore_careers.sql
+-- G6.3 — Encore Careers: job board for members 55+ seeking meaningful work
+
+CREATE TYPE career_work_type AS ENUM ('full_time', 'part_time', 'contract', 'volunteer', 'consulting', 'flexible');
+CREATE TYPE opportunity_status AS ENUM ('draft', 'active', 'filled', 'expired', 'archived');
+CREATE TYPE career_interest_status AS ENUM ('interested', 'applied', 'interviewing', 'offered', 'declined', 'hired');
+
+-- Member career profiles (opt-in)
+CREATE TABLE IF NOT EXISTS career_profiles (
+  id                  uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at          timestamptz DEFAULT now() NOT NULL,
+  updated_at          timestamptz DEFAULT now() NOT NULL,
+  member_id           uuid NOT NULL UNIQUE REFERENCES members(id) ON DELETE CASCADE,
+  active              boolean NOT NULL DEFAULT true,
+
+  -- Background
+  headline            text,                   -- e.g. "Retired teacher seeking tutoring work"
+  summary             text,                   -- short bio / what they offer
+  skills              text[],                 -- ["Teaching", "Excel", "Project Management"]
+  industries          text[],                 -- ["Education", "Nonprofit", "Healthcare"]
+  years_experience    integer,
+
+  -- Preferences
+  work_types          career_work_type[],     -- what they are open to
+  hours_per_week_max  integer,                -- max hours willing to work
+  remote_ok           boolean NOT NULL DEFAULT true,
+  in_person_ok        boolean NOT NULL DEFAULT true,
+  desired_pay         text,                   -- free text: "$20-25/hr", "volunteer only", etc.
+  available_from      date,
+
+  -- Digest opt-in
+  digest_opted_in     boolean NOT NULL DEFAULT true
+);
+
+-- Job / volunteer opportunities
+CREATE TABLE IF NOT EXISTS career_opportunities (
+  id                  uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at          timestamptz DEFAULT now() NOT NULL,
+  updated_at          timestamptz DEFAULT now() NOT NULL,
+  posted_by           uuid REFERENCES members(id),    -- staff member who posted
+  status              opportunity_status NOT NULL DEFAULT 'active',
+
+  title               text NOT NULL,
+  organization        text NOT NULL,
+  description         text NOT NULL,
+  work_type           career_work_type NOT NULL,
+  location            text,                   -- "Foster City, CA" or "Remote"
+  remote_ok           boolean NOT NULL DEFAULT false,
+  hours_per_week      text,                   -- "10-15 hrs/week"
+  pay                 text,                   -- "$18/hr", "Volunteer", "Negotiable"
+  skills_desired      text[],
+  industries          text[],
+  apply_url           text,
+  apply_email         text,
+  closes_on           date,
+  filled_at           timestamptz
+);
+
+-- Member interest / applications
+CREATE TABLE IF NOT EXISTS career_interests (
+  id                  uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at          timestamptz DEFAULT now() NOT NULL,
+  updated_at          timestamptz DEFAULT now() NOT NULL,
+  member_id           uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  opportunity_id      uuid NOT NULL REFERENCES career_opportunities(id) ON DELETE CASCADE,
+  status              career_interest_status NOT NULL DEFAULT 'interested',
+  note                text,                   -- member's cover note
+  navigator_notes     text,
+  UNIQUE (member_id, opportunity_id)
+);
+
+-- Weekly digest log (prevent duplicate sends)
+CREATE TABLE IF NOT EXISTS career_digest_log (
+  id                  uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  sent_at             timestamptz DEFAULT now() NOT NULL,
+  member_id           uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  opportunity_ids     uuid[] NOT NULL,
+  week_of             date NOT NULL,
+  UNIQUE (member_id, week_of)
+);
+
+-- RLS
+ALTER TABLE career_profiles ENABLE ROW LEVEL SECURITY;
+ALTER TABLE career_opportunities ENABLE ROW LEVEL SECURITY;
+ALTER TABLE career_interests ENABLE ROW LEVEL SECURITY;
+ALTER TABLE career_digest_log ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY "member manages own career profile"
+  ON career_profiles FOR ALL
+  USING (member_id = ANY(acting_member_ids()));
+
+CREATE POLICY "staff sees all career profiles"
+  ON career_profiles FOR SELECT
+  USING (is_staff());
+
+CREATE POLICY "active opportunities visible to members"
+  ON career_opportunities FOR SELECT
+  USING (status = 'active' OR is_staff());
+
+CREATE POLICY "staff manages opportunities"
+  ON career_opportunities FOR ALL
+  USING (is_staff());
+
+CREATE POLICY "member manages own interests"
+  ON career_interests FOR ALL
+  USING (member_id = ANY(acting_member_ids()));
+
+CREATE POLICY "staff sees all interests"
+  ON career_interests FOR SELECT
+  USING (is_staff());
+
+CREATE POLICY "staff sees digest log"
+  ON career_digest_log FOR ALL
+  USING (is_staff());
+
+-- updated_at triggers
+CREATE OR REPLACE FUNCTION touch_career_profile() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.updated_at = now(); RETURN NEW; END; $$;
+CREATE TRIGGER career_profiles_updated BEFORE UPDATE ON career_profiles FOR EACH ROW EXECUTE FUNCTION touch_career_profile();
+
+CREATE OR REPLACE FUNCTION touch_career_opportunity() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.updated_at = now(); RETURN NEW; END; $$;
+CREATE TRIGGER career_opportunities_updated BEFORE UPDATE ON career_opportunities FOR EACH ROW EXECUTE FUNCTION touch_career_opportunity();
+
+-- Indexes
+CREATE INDEX IF NOT EXISTS career_profiles_member_idx ON career_profiles(member_id);
+CREATE INDEX IF NOT EXISTS career_opportunities_status_idx ON career_opportunities(status);
+CREATE INDEX IF NOT EXISTS career_interests_member_idx ON career_interests(member_id);
+CREATE INDEX IF NOT EXISTS career_interests_opportunity_idx ON career_interests(opportunity_id);
diff --git a/supabase/migrations/100_volunteer_ecosystem.sql b/supabase/migrations/100_volunteer_ecosystem.sql
new file mode 100644
index 0000000..d502110
--- /dev/null
+++ b/supabase/migrations/100_volunteer_ecosystem.sql
@@ -0,0 +1,86 @@
+-- 100_volunteer_ecosystem.sql
+-- G5.10 — Volunteer ecosystem completion
+-- 1. VSO affiliation on volunteers
+-- 2. Corporate volunteer program tiers
+-- 3. Family reciprocity time-bank credits
+
+-- ── 1. VSO affiliation ────────────────────────────────────────────────────────
+
+DO $$ BEGIN
+  CREATE TYPE vso_affiliation AS ENUM ('vfw', 'american_legion', 'dav', 'amvets', 'moaa', 'uso', 'other', 'none');
+EXCEPTION WHEN duplicate_object THEN NULL; END $$;
+
+ALTER TABLE volunteers
+  ADD COLUMN IF NOT EXISTS vso_affiliation vso_affiliation NOT NULL DEFAULT 'none',
+  ADD COLUMN IF NOT EXISTS vso_member_number text;   -- optional membership #
+
+-- ── 2. Corporate volunteer tiers ─────────────────────────────────────────────
+
+DO $$ BEGIN
+  CREATE TYPE corp_volunteer_tier AS ENUM ('partner', 'champion', 'leader');
+EXCEPTION WHEN duplicate_object THEN NULL; END $$;
+
+-- Add tier + hour target to corporate_volunteer_programs if it exists
+DO $$ BEGIN
+  ALTER TABLE corporate_volunteer_programs
+    ADD COLUMN IF NOT EXISTS tier corp_volunteer_tier NOT NULL DEFAULT 'partner',
+    ADD COLUMN IF NOT EXISTS hour_target integer NOT NULL DEFAULT 200,
+    ADD COLUMN IF NOT EXISTS recognition_badge_url text;
+EXCEPTION WHEN undefined_table THEN NULL; END $$;
+
+-- ── 3. Family reciprocity time-bank ──────────────────────────────────────────
+
+-- Credits earned by family volunteers helping other seniors
+CREATE TABLE IF NOT EXISTS time_bank_credits (
+  id                uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at        timestamptz DEFAULT now() NOT NULL,
+
+  -- Who earned it (a family_member volunteering for another senior)
+  earner_family_member_id uuid NOT NULL REFERENCES family_members(id) ON DELETE CASCADE,
+
+  -- The senior whose account benefits (the earner's own senior)
+  beneficiary_member_id   uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+
+  -- The volunteer service that was performed
+  service_booking_id      uuid REFERENCES service_bookings(id) ON DELETE SET NULL,
+
+  -- How many credits (1 credit = 1 hour by default)
+  credits               numeric(6,2) NOT NULL CHECK (credits > 0),
+  hours_served          numeric(6,2) NOT NULL CHECK (hours_served > 0),
+
+  -- What it was
+  service_type          text NOT NULL,  -- e.g. "Grocery run", "Companionship call"
+  performed_for_member_id uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE, -- the OTHER senior
+
+  -- Redemption
+  redeemed_at           timestamptz,
+  redeemed_service_booking_id uuid REFERENCES service_bookings(id) ON DELETE SET NULL,
+
+  note                  text
+);
+
+-- Guard: earner's own senior may not be the same as performed_for_member_id
+-- Enforced in API; DB-level check requires joining family_members which isn't possible here
+
+CREATE INDEX IF NOT EXISTS time_bank_credits_earner_idx ON time_bank_credits(earner_family_member_id);
+CREATE INDEX IF NOT EXISTS time_bank_credits_beneficiary_idx ON time_bank_credits(beneficiary_member_id);
+
+-- RLS
+ALTER TABLE time_bank_credits ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY "family member sees own credits"
+  ON time_bank_credits FOR SELECT
+  USING (earner_family_member_id IN (
+    SELECT id FROM family_members WHERE supabase_auth_id = auth.uid()
+  ));
+
+CREATE POLICY "beneficiary member sees credits on their account"
+  ON time_bank_credits FOR SELECT
+  USING (beneficiary_member_id = ANY(acting_member_ids()));
+
+CREATE POLICY "staff manages all time bank credits"
+  ON time_bank_credits FOR ALL
+  USING (is_staff());
+
+-- ── Indexes on volunteers ─────────────────────────────────────────────────────
+CREATE INDEX IF NOT EXISTS volunteers_vso_idx ON volunteers(vso_affiliation);
diff --git a/supabase/migrations/101_life_transitions.sql b/supabase/migrations/101_life_transitions.sql
new file mode 100644
index 0000000..0945459
--- /dev/null
+++ b/supabase/migrations/101_life_transitions.sql
@@ -0,0 +1,149 @@
+-- 101_life_transitions.sql
+-- G5.5 — Life transitions depth
+-- 1. Facility-move planning tables (transition_plans + transition_plan_steps)
+-- 2. Extend trusted_advisors with therapist / grief_counselor / chaplain categories
+-- 3. advisor_connections table (warm introduction requests)
+
+-- ── 1. Facility-move planning ─────────────────────────────────────────────────
+
+CREATE TABLE IF NOT EXISTS transition_plans (
+  id                  uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at          timestamptz DEFAULT now() NOT NULL,
+  updated_at          timestamptz DEFAULT now() NOT NULL,
+  member_id           uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  navigator_id        uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  title               text NOT NULL DEFAULT 'Facility Move Plan',
+  status              text NOT NULL DEFAULT 'active'
+                        CHECK (status IN ('active', 'completed', 'cancelled')),
+  family_can_view      boolean NOT NULL DEFAULT false,
+  target_move_date    date,
+  facility_name       text,
+  facility_address    text,
+  notes               text
+);
+
+CREATE TABLE IF NOT EXISTS transition_plan_steps (
+  id                  uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at          timestamptz DEFAULT now() NOT NULL,
+  plan_id             uuid NOT NULL REFERENCES transition_plans(id) ON DELETE CASCADE,
+  week_number         integer NOT NULL CHECK (week_number BETWEEN 1 AND 6),
+  title               text NOT NULL,
+  description         text,
+  due_date            date,
+  completed_at        timestamptz,
+  completed_by        uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  category            text NOT NULL DEFAULT 'general'
+                        CHECK (category IN ('research','visits','transport','paperwork','family','moving','post_move','general')),
+  sort_order          integer NOT NULL DEFAULT 0
+);
+
+CREATE INDEX IF NOT EXISTS transition_plans_member_idx ON transition_plans(member_id);
+CREATE INDEX IF NOT EXISTS transition_plan_steps_plan_idx ON transition_plan_steps(plan_id);
+
+ALTER TABLE transition_plans ENABLE ROW LEVEL SECURITY;
+ALTER TABLE transition_plan_steps ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "member sees own transition plans" ON transition_plans;
+CREATE POLICY "member sees own transition plans"
+  ON transition_plans FOR SELECT
+  USING (member_id = ANY(acting_member_ids()));
+
+DROP POLICY IF EXISTS "family sees plans when allowed" ON transition_plans;
+CREATE POLICY "family sees plans when allowed"
+  ON transition_plans FOR SELECT
+  USING (
+    family_can_view AND member_id IN (
+      SELECT member_id FROM family_members WHERE supabase_auth_id = auth.uid()
+    )
+  );
+
+DROP POLICY IF EXISTS "staff manages transition plans" ON transition_plans;
+CREATE POLICY "staff manages transition plans"
+  ON transition_plans FOR ALL
+  USING (is_staff());
+
+DROP POLICY IF EXISTS "member sees own plan steps" ON transition_plan_steps;
+CREATE POLICY "member sees own plan steps"
+  ON transition_plan_steps FOR SELECT
+  USING (plan_id IN (
+    SELECT id FROM transition_plans WHERE member_id = ANY(acting_member_ids())
+  ));
+
+DROP POLICY IF EXISTS "family sees steps when plan allows" ON transition_plan_steps;
+CREATE POLICY "family sees steps when plan allows"
+  ON transition_plan_steps FOR SELECT
+  USING (plan_id IN (
+    SELECT id FROM transition_plans
+    WHERE family_can_view
+      AND member_id IN (
+        SELECT member_id FROM family_members WHERE supabase_auth_id = auth.uid()
+      )
+  ));
+
+DROP POLICY IF EXISTS "staff manages plan steps" ON transition_plan_steps;
+CREATE POLICY "staff manages plan steps"
+  ON transition_plan_steps FOR ALL
+  USING (is_staff());
+
+-- updated_at trigger
+CREATE OR REPLACE FUNCTION touch_transition_plan()
+  RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN NEW.updated_at = now(); RETURN NEW; END; $$;
+
+DROP TRIGGER IF EXISTS transition_plans_updated ON transition_plans;
+CREATE TRIGGER transition_plans_updated
+  BEFORE UPDATE ON transition_plans
+  FOR EACH ROW EXECUTE FUNCTION touch_transition_plan();
+
+-- ── 2. Extend trusted_advisors ────────────────────────────────────────────────
+-- Add new professional categories + license fields + telehealth flag
+-- (trusted_advisors table was created in migration 065)
+
+ALTER TABLE trusted_advisors
+  ADD COLUMN IF NOT EXISTS license_number    text,
+  ADD COLUMN IF NOT EXISTS license_state     text,
+  ADD COLUMN IF NOT EXISTS telehealth_ok     boolean NOT NULL DEFAULT false,
+  ADD COLUMN IF NOT EXISTS member_request_only boolean NOT NULL DEFAULT false;
+
+-- advisor_type is a Postgres enum (public.advisor_type).
+-- Add therapist, grief_counselor, chaplain values if not already present.
+DO $$ BEGIN
+  ALTER TYPE advisor_type ADD VALUE IF NOT EXISTS 'therapist';
+EXCEPTION WHEN OTHERS THEN NULL; END $$;
+DO $$ BEGIN
+  ALTER TYPE advisor_type ADD VALUE IF NOT EXISTS 'grief_counselor';
+EXCEPTION WHEN OTHERS THEN NULL; END $$;
+DO $$ BEGIN
+  ALTER TYPE advisor_type ADD VALUE IF NOT EXISTS 'chaplain';
+EXCEPTION WHEN OTHERS THEN NULL; END $$;
+
+-- ── 3. advisor_connections — warm introduction requests ───────────────────────
+
+CREATE TABLE IF NOT EXISTS advisor_connections (
+  id                  uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at          timestamptz DEFAULT now() NOT NULL,
+  updated_at          timestamptz DEFAULT now() NOT NULL,
+  member_id           uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  advisor_id          uuid NOT NULL REFERENCES trusted_advisors(id) ON DELETE CASCADE,
+  status              text NOT NULL DEFAULT 'requested'
+                        CHECK (status IN ('requested','navigator_reviewing','intro_sent','connected','declined')),
+  member_note         text,
+  navigator_notes     text,
+  introduced_at       timestamptz,
+  UNIQUE (member_id, advisor_id)
+);
+
+CREATE INDEX IF NOT EXISTS advisor_connections_member_idx ON advisor_connections(member_id);
+CREATE INDEX IF NOT EXISTS advisor_connections_advisor_idx ON advisor_connections(advisor_id);
+
+ALTER TABLE advisor_connections ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "member manages own advisor connections" ON advisor_connections;
+CREATE POLICY "member manages own advisor connections"
+  ON advisor_connections FOR ALL
+  USING (member_id = ANY(acting_member_ids()));
+
+DROP POLICY IF EXISTS "staff manages all advisor connections" ON advisor_connections;
+CREATE POLICY "staff manages all advisor connections"
+  ON advisor_connections FOR ALL
+  USING (is_staff());
diff --git a/supabase/migrations/102_circle_content_feed.sql b/supabase/migrations/102_circle_content_feed.sql
new file mode 100644
index 0000000..801e11c
--- /dev/null
+++ b/supabase/migrations/102_circle_content_feed.sql
@@ -0,0 +1,64 @@
+-- 102_circle_content_feed.sql
+-- G5.6 — Cultural Content Feed
+-- Adds circle_content_items: curated articles, videos, recipes, spotlights
+-- posted by navigators/staff into circle feeds.
+
+CREATE TABLE IF NOT EXISTS circle_content_items (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at      timestamptz DEFAULT now() NOT NULL,
+  updated_at      timestamptz DEFAULT now() NOT NULL,
+  circle_id       uuid NOT NULL REFERENCES cultural_circles(id) ON DELETE CASCADE,
+  posted_by       uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  content_type    text NOT NULL DEFAULT 'article'
+                    CHECK (content_type IN ('article','video','recipe','spotlight','announcement','event_recap')),
+  title           text NOT NULL,
+  body            text,
+  url             text,
+  image_url       text,
+  source_name     text,
+  tags            text[] NOT NULL DEFAULT '{}',
+  is_pinned       boolean NOT NULL DEFAULT false,
+  is_published    boolean NOT NULL DEFAULT true,
+  published_at    timestamptz DEFAULT now()
+);
+
+CREATE INDEX IF NOT EXISTS circle_content_circle_idx ON circle_content_items(circle_id, published_at DESC);
+CREATE INDEX IF NOT EXISTS circle_content_pinned_idx ON circle_content_items(circle_id, is_pinned) WHERE is_pinned = true;
+
+ALTER TABLE circle_content_items ENABLE ROW LEVEL SECURITY;
+
+-- Members can read published content for circles they belong to
+-- Uses circle_memberships join through cultural_circles to avoid direct table ref issues
+DROP POLICY IF EXISTS "members read circle content" ON circle_content_items;
+CREATE POLICY "members read circle content"
+  ON circle_content_items FOR SELECT
+  USING (
+    is_published AND (
+      EXISTS (
+        SELECT 1 FROM circle_memberships cm
+        WHERE cm.circle_id = circle_content_items.circle_id
+          AND cm.member_id = ANY(acting_member_ids())
+      )
+      OR EXISTS (
+        SELECT 1 FROM cultural_circles cc
+        WHERE cc.id = circle_content_items.circle_id
+          AND cc.membership_visibility = 'open'
+      )
+    )
+  );
+
+-- Staff manage all content
+DROP POLICY IF EXISTS "staff manages circle content" ON circle_content_items;
+CREATE POLICY "staff manages circle content"
+  ON circle_content_items FOR ALL
+  USING (is_staff());
+
+-- updated_at trigger
+CREATE OR REPLACE FUNCTION touch_circle_content()
+  RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN NEW.updated_at = now(); RETURN NEW; END; $$;
+
+DROP TRIGGER IF EXISTS circle_content_updated ON circle_content_items;
+CREATE TRIGGER circle_content_updated
+  BEFORE UPDATE ON circle_content_items
+  FOR EACH ROW EXECUTE FUNCTION touch_circle_content();
diff --git a/supabase/migrations/103_birthday_achievements.sql b/supabase/migrations/103_birthday_achievements.sql
new file mode 100644
index 0000000..d806e2a
--- /dev/null
+++ b/supabase/migrations/103_birthday_achievements.sql
@@ -0,0 +1,76 @@
+-- 103_birthday_achievements.sql
+-- G5.4 — Birthday arc + member achievements
+-- 1. Add birth_date to members
+-- 2. member_achievements table
+-- 3. birthday_messages table (navigator sends birthday cards/messages)
+
+-- ── 1. Birth date on members ──────────────────────────────────────────────────
+
+ALTER TABLE members
+  ADD COLUMN IF NOT EXISTS birth_date date,
+  ADD COLUMN IF NOT EXISTS birth_date_year_hidden boolean NOT NULL DEFAULT false;
+
+-- ── 2. Member achievements ────────────────────────────────────────────────────
+
+CREATE TABLE IF NOT EXISTS member_achievements (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at      timestamptz DEFAULT now() NOT NULL,
+  member_id       uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  achievement_key text NOT NULL,
+  title           text NOT NULL,
+  description     text,
+  icon            text NOT NULL DEFAULT '🏆',
+  awarded_at      timestamptz DEFAULT now() NOT NULL,
+  UNIQUE (member_id, achievement_key)
+);
+
+CREATE INDEX IF NOT EXISTS member_achievements_member_idx ON member_achievements(member_id);
+
+ALTER TABLE member_achievements ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "member sees own achievements" ON member_achievements;
+CREATE POLICY "member sees own achievements"
+  ON member_achievements FOR SELECT
+  USING (member_id = ANY(acting_member_ids()));
+
+DROP POLICY IF EXISTS "family sees member achievements" ON member_achievements;
+CREATE POLICY "family sees member achievements"
+  ON member_achievements FOR SELECT
+  USING (
+    member_id IN (
+      SELECT member_id FROM family_members WHERE supabase_auth_id = auth.uid()
+    )
+  );
+
+DROP POLICY IF EXISTS "staff manages achievements" ON member_achievements;
+CREATE POLICY "staff manages achievements"
+  ON member_achievements FOR ALL
+  USING (is_staff());
+
+-- ── 3. Birthday messages ──────────────────────────────────────────────────────
+
+CREATE TABLE IF NOT EXISTS birthday_messages (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at      timestamptz DEFAULT now() NOT NULL,
+  member_id       uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  sent_by         uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  message         text NOT NULL,
+  sent_at         timestamptz DEFAULT now() NOT NULL,
+  delivery_method text NOT NULL DEFAULT 'in_app'
+                    CHECK (delivery_method IN ('in_app', 'sms', 'email')),
+  birthday_year   integer NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS birthday_messages_member_idx ON birthday_messages(member_id);
+
+ALTER TABLE birthday_messages ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "member sees own birthday messages" ON birthday_messages;
+CREATE POLICY "member sees own birthday messages"
+  ON birthday_messages FOR SELECT
+  USING (member_id = ANY(acting_member_ids()));
+
+DROP POLICY IF EXISTS "staff manages birthday messages" ON birthday_messages;
+CREATE POLICY "staff manages birthday messages"
+  ON birthday_messages FOR ALL
+  USING (is_staff());
diff --git a/supabase/migrations/104_ride_bookings.sql b/supabase/migrations/104_ride_bookings.sql
new file mode 100644
index 0000000..f4b0b6f
--- /dev/null
+++ b/supabase/migrations/104_ride_bookings.sql
@@ -0,0 +1,122 @@
+-- 104_ride_bookings.sql
+-- G5.8 — Event ride booking requests + family daily summary log
+
+-- ────────────────────────────────────────────────
+-- 1. Ride booking requests
+-- ────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS ride_bookings (
+  id               uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at       timestamptz DEFAULT now() NOT NULL,
+  updated_at       timestamptz DEFAULT now() NOT NULL,
+  member_id        uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  event_id         uuid REFERENCES events(id) ON DELETE SET NULL,
+  requested_by     uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  pickup_address   text,
+  dropoff_address  text,
+  pickup_time      timestamptz,
+  notes            text,
+  status           text NOT NULL DEFAULT 'requested'
+                     CHECK (status IN ('requested','confirmed','en_route','completed','cancelled')),
+  driver_name      text,
+  driver_phone     text,
+  confirmed_at     timestamptz,
+  cancelled_at     timestamptz,
+  cancel_reason    text
+);
+
+ALTER TABLE ride_bookings ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "member sees own ride bookings" ON ride_bookings;
+CREATE POLICY "member sees own ride bookings"
+  ON ride_bookings FOR SELECT
+  USING (member_id = ANY(acting_member_ids()));
+
+DROP POLICY IF EXISTS "family member sees own requests" ON ride_bookings;
+CREATE POLICY "family member sees own requests"
+  ON ride_bookings FOR SELECT
+  USING (
+    EXISTS (
+      SELECT 1 FROM family_members fm
+      WHERE fm.id = ride_bookings.requested_by
+        AND fm.supabase_auth_id = auth.uid()
+    )
+  );
+
+DROP POLICY IF EXISTS "staff sees all ride bookings" ON ride_bookings;
+CREATE POLICY "staff sees all ride bookings"
+  ON ride_bookings FOR SELECT
+  USING (is_staff());
+
+DROP POLICY IF EXISTS "family member can request ride" ON ride_bookings;
+CREATE POLICY "family member can request ride"
+  ON ride_bookings FOR INSERT
+  WITH CHECK (
+    EXISTS (
+      SELECT 1 FROM family_members fm
+      WHERE fm.supabase_auth_id = auth.uid()
+        AND fm.member_id = ride_bookings.member_id
+    )
+    OR is_staff()
+  );
+
+DROP POLICY IF EXISTS "staff can update ride bookings" ON ride_bookings;
+CREATE POLICY "staff can update ride bookings"
+  ON ride_bookings FOR UPDATE
+  USING (is_staff());
+
+DROP POLICY IF EXISTS "requester can cancel ride" ON ride_bookings;
+CREATE POLICY "requester can cancel ride"
+  ON ride_bookings FOR UPDATE
+  USING (
+    status IN ('requested','confirmed')
+    AND (
+      EXISTS (
+        SELECT 1 FROM family_members fm
+        WHERE fm.id = ride_bookings.requested_by
+          AND fm.supabase_auth_id = auth.uid()
+      )
+      OR member_id = ANY(acting_member_ids())
+    )
+  );
+
+-- ────────────────────────────────────────────────
+-- 2. Family daily summary log (tracks what was sent)
+-- ────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS family_summary_log (
+  id          uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at  timestamptz DEFAULT now() NOT NULL,
+  member_id   uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  sent_at     timestamptz DEFAULT now() NOT NULL,
+  summary_date date NOT NULL,
+  channel     text NOT NULL DEFAULT 'sms' CHECK (channel IN ('sms','email','in_app')),
+  recipient   text,          -- phone or email sent to
+  body        text NOT NULL,
+  status      text NOT NULL DEFAULT 'sent' CHECK (status IN ('sent','failed','skipped')),
+  error       text,
+  UNIQUE (member_id, summary_date, channel)
+);
+
+ALTER TABLE family_summary_log ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "staff sees summary log" ON family_summary_log;
+CREATE POLICY "staff sees summary log"
+  ON family_summary_log FOR SELECT
+  USING (is_staff());
+
+DROP POLICY IF EXISTS "staff inserts summary log" ON family_summary_log;
+CREATE POLICY "staff inserts summary log"
+  ON family_summary_log FOR INSERT
+  WITH CHECK (is_staff());
+
+-- ────────────────────────────────────────────────
+-- 3. Updated_at trigger for ride_bookings
+-- ────────────────────────────────────────────────
+CREATE OR REPLACE FUNCTION update_updated_at_column()
+RETURNS TRIGGER AS $$
+BEGIN NEW.updated_at = now(); RETURN NEW; END;
+$$ LANGUAGE plpgsql;
+
+DROP TRIGGER IF EXISTS set_ride_bookings_updated_at ON ride_bookings;
+CREATE TRIGGER set_ride_bookings_updated_at
+  BEFORE UPDATE ON ride_bookings
+  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
diff --git a/supabase/migrations/105_plan_entitlements.sql b/supabase/migrations/105_plan_entitlements.sql
new file mode 100644
index 0000000..c35cd79
--- /dev/null
+++ b/supabase/migrations/105_plan_entitlements.sql
@@ -0,0 +1,310 @@
+-- 105_plan_entitlements.sql
+-- G5.7 — Plan tiers, add-on SKUs, member plan assignments, navigator time logs
+
+-- ────────────────────────────────────────────────
+-- 1. Plan tiers
+-- ────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS plans (
+  id               uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at       timestamptz DEFAULT now() NOT NULL,
+  updated_at       timestamptz DEFAULT now() NOT NULL,
+  name             text NOT NULL UNIQUE,          -- 'Essential', 'Standard', 'Premium'
+  slug             text NOT NULL UNIQUE,          -- 'essential', 'standard', 'premium'
+  description      text,
+  price_cents      integer NOT NULL DEFAULT 0,    -- monthly price in cents
+  billing_interval text NOT NULL DEFAULT 'month'
+                     CHECK (billing_interval IN ('month', 'year')),
+  is_active        boolean NOT NULL DEFAULT true,
+  sort_order       integer NOT NULL DEFAULT 0,
+  -- Feature entitlements (boolean flags + numeric limits)
+  entitlements     jsonb NOT NULL DEFAULT '{}'
+);
+
+ALTER TABLE plans ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "anyone can read active plans" ON plans;
+CREATE POLICY "anyone can read active plans"
+  ON plans FOR SELECT
+  USING (is_active OR is_staff());
+
+DROP POLICY IF EXISTS "staff manages plans" ON plans;
+CREATE POLICY "staff manages plans"
+  ON plans FOR ALL
+  USING (is_staff())
+  WITH CHECK (is_staff());
+
+-- ────────────────────────────────────────────────
+-- 2. Add-on SKUs
+-- ────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS addon_skus (
+  id               uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at       timestamptz DEFAULT now() NOT NULL,
+  name             text NOT NULL UNIQUE,
+  slug             text NOT NULL UNIQUE,
+  description      text,
+  price_cents      integer NOT NULL DEFAULT 0,
+  billing_interval text NOT NULL DEFAULT 'month'
+                     CHECK (billing_interval IN ('month', 'year', 'one_time')),
+  category         text NOT NULL DEFAULT 'service'
+                     CHECK (category IN ('service','device','companion','wellness','transport')),
+  is_active        boolean NOT NULL DEFAULT true,
+  requires_plan_slug text,    -- null = available on any plan; or 'standard','premium' etc.
+  entitlement_key  text,      -- optional: adds a boolean key to member entitlements when purchased
+  sort_order       integer NOT NULL DEFAULT 0
+);
+
+ALTER TABLE addon_skus ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "anyone can read active addons" ON addon_skus;
+CREATE POLICY "anyone can read active addons"
+  ON addon_skus FOR SELECT
+  USING (is_active OR is_staff());
+
+DROP POLICY IF EXISTS "staff manages addons" ON addon_skus;
+CREATE POLICY "staff manages addons"
+  ON addon_skus FOR ALL
+  USING (is_staff())
+  WITH CHECK (is_staff());
+
+-- ────────────────────────────────────────────────
+-- 3. Member plan assignments
+-- ────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS member_plans (
+  id               uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at       timestamptz DEFAULT now() NOT NULL,
+  updated_at       timestamptz DEFAULT now() NOT NULL,
+  member_id        uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  plan_id          uuid NOT NULL REFERENCES plans(id),
+  status           text NOT NULL DEFAULT 'active'
+                     CHECK (status IN ('active','paused','cancelled','trial')),
+  started_at       timestamptz DEFAULT now() NOT NULL,
+  trial_ends_at    timestamptz,
+  cancelled_at     timestamptz,
+  cancel_reason    text,
+  stripe_subscription_id text,
+  assigned_by      uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  notes            text,
+  UNIQUE (member_id, plan_id, status)
+);
+
+ALTER TABLE member_plans ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "member sees own plan" ON member_plans;
+CREATE POLICY "member sees own plan"
+  ON member_plans FOR SELECT
+  USING (member_id = ANY(acting_member_ids()));
+
+DROP POLICY IF EXISTS "family sees member plan" ON member_plans;
+CREATE POLICY "family sees member plan"
+  ON member_plans FOR SELECT
+  USING (
+    EXISTS (
+      SELECT 1 FROM family_members fm
+      WHERE fm.supabase_auth_id = auth.uid()
+        AND fm.member_id = member_plans.member_id
+    )
+  );
+
+DROP POLICY IF EXISTS "staff sees all member plans" ON member_plans;
+CREATE POLICY "staff sees all member plans"
+  ON member_plans FOR SELECT
+  USING (is_staff());
+
+DROP POLICY IF EXISTS "staff manages member plans" ON member_plans;
+CREATE POLICY "staff manages member plans"
+  ON member_plans FOR ALL
+  USING (is_staff())
+  WITH CHECK (is_staff());
+
+-- ────────────────────────────────────────────────
+-- 4. Member add-on subscriptions
+-- ────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS member_addons (
+  id               uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at       timestamptz DEFAULT now() NOT NULL,
+  member_id        uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  addon_id         uuid NOT NULL REFERENCES addon_skus(id),
+  status           text NOT NULL DEFAULT 'active'
+                     CHECK (status IN ('active','cancelled','expired')),
+  started_at       timestamptz DEFAULT now() NOT NULL,
+  expires_at       timestamptz,
+  cancelled_at     timestamptz,
+  stripe_subscription_id text,
+  assigned_by      uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  UNIQUE (member_id, addon_id, status)
+);
+
+ALTER TABLE member_addons ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "member sees own addons" ON member_addons;
+CREATE POLICY "member sees own addons"
+  ON member_addons FOR SELECT
+  USING (member_id = ANY(acting_member_ids()));
+
+DROP POLICY IF EXISTS "family sees member addons" ON member_addons;
+CREATE POLICY "family sees member addons"
+  ON member_addons FOR SELECT
+  USING (
+    EXISTS (
+      SELECT 1 FROM family_members fm
+      WHERE fm.supabase_auth_id = auth.uid()
+        AND fm.member_id = member_addons.member_id
+    )
+  );
+
+DROP POLICY IF EXISTS "staff manages member addons" ON member_addons;
+CREATE POLICY "staff manages member addons"
+  ON member_addons FOR ALL
+  USING (is_staff())
+  WITH CHECK (is_staff());
+
+-- ────────────────────────────────────────────────
+-- 5. Navigator time logs
+-- ────────────────────────────────────────────────
+CREATE TABLE IF NOT EXISTS navigator_time_logs (
