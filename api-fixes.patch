+++ b/supabase/migrations/112_family_celebrations.sql
@@ -0,0 +1,151 @@
+-- Migration 112: G7.2 + G7.3 + G7.4 — Family Events Calendar, Gift Orders, Celebrations
+-- Covers: family_events, gift_orders, celebration_requests, celebration_messages
+
+-- ── family_events ─────────────────────────────────────────────────────────────
+-- Family members record events for their senior (birthdays, anniversaries, etc.)
+-- Aria gets context 7 days out and day-of; notifications fire to family
+
+CREATE TABLE IF NOT EXISTS family_events (
+  id             uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at     timestamptz DEFAULT now() NOT NULL,
+  member_id      uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  created_by     uuid NOT NULL REFERENCES family_members(id) ON DELETE CASCADE,
+  event_type     text NOT NULL CHECK (event_type IN (
+                   'birthday','anniversary','holiday','milestone',
+                   'graduation','homecoming','other'
+                 )),
+  title          text NOT NULL CHECK (char_length(title) BETWEEN 1 AND 120),
+  event_date     date NOT NULL,
+  recurring      boolean NOT NULL DEFAULT false,
+  notes          text,
+  aria_notified_7d  boolean NOT NULL DEFAULT false,
+  aria_notified_1d  boolean NOT NULL DEFAULT false,
+  family_notified   boolean NOT NULL DEFAULT false,
+  cancelled_at   timestamptz
+);
+
+CREATE INDEX IF NOT EXISTS family_events_member_id_idx ON family_events(member_id);
+CREATE INDEX IF NOT EXISTS family_events_event_date_idx ON family_events(event_date);
+CREATE INDEX IF NOT EXISTS family_events_upcoming_idx
+  ON family_events(member_id, event_date)
+  WHERE cancelled_at IS NULL;
+
+ALTER TABLE family_events ENABLE ROW LEVEL SECURITY;
+
+-- Member can read their own events
+CREATE POLICY "fe_member_read" ON family_events
+  FOR SELECT USING (member_id = ANY(acting_member_ids()));
+
+-- Family can read + manage events for their member
+CREATE POLICY "fe_family_all" ON family_events
+  FOR ALL USING (member_id = ANY(acting_member_ids()));
+
+-- Staff can read all
+CREATE POLICY "fe_staff_read" ON family_events
+  FOR SELECT USING (is_staff());
+
+-- ── gift_orders ───────────────────────────────────────────────────────────────
+-- Senior sends gifts/cards to family members
+
+CREATE TABLE IF NOT EXISTS gift_orders (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at      timestamptz DEFAULT now() NOT NULL,
+  member_id       uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  recipient_name  text NOT NULL,
+  recipient_email text,
+  gift_type       text NOT NULL CHECK (gift_type IN (
+                    'greeting_card','flower_bouquet','gift_basket',
+                    'photo_book','meal_delivery','donation_in_honor',
+                    'amazon_gift_card','book','plant','custom'
+                  )),
+  gift_label      text NOT NULL,        -- human-readable name from catalog
+  amount_cents    integer,              -- null for free/card-only items
+  stripe_pi_id    text,                 -- Stripe PaymentIntent id
+  message         text,
+  status          text NOT NULL DEFAULT 'pending'
+                    CHECK (status IN ('pending','processing','shipped','delivered','cancelled')),
+  tracking_url    text,
+  event_id        uuid REFERENCES family_events(id) ON DELETE SET NULL
+);
+
+CREATE INDEX IF NOT EXISTS gift_orders_member_id_idx ON gift_orders(member_id);
+CREATE INDEX IF NOT EXISTS gift_orders_status_idx ON gift_orders(status);
+
+ALTER TABLE gift_orders ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY "go_member_all" ON gift_orders
+  FOR ALL USING (member_id = ANY(acting_member_ids()));
+
+CREATE POLICY "go_staff_read" ON gift_orders
+  FOR SELECT USING (is_staff());
+
+-- ── celebration_requests ──────────────────────────────────────────────────────
+-- Family organises a celebration for their senior (3 tiers)
+
+CREATE TABLE IF NOT EXISTS celebration_requests (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at      timestamptz DEFAULT now() NOT NULL,
+  member_id       uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  requested_by    uuid NOT NULL REFERENCES family_members(id) ON DELETE CASCADE,
+  event_id        uuid REFERENCES family_events(id) ON DELETE SET NULL,
+  tier            text NOT NULL CHECK (tier IN ('basic','enhanced','premium')),
+  -- basic=$0 (digital card + Aria shout-out)
+  -- enhanced=$25 (+ physical card + gift)
+  -- premium=$75 (+ printed photo book + personal note from care team)
+  amount_cents    integer NOT NULL DEFAULT 0,
+  stripe_pi_id    text,
+  status          text NOT NULL DEFAULT 'pending'
+                    CHECK (status IN ('pending','paid','in_review','active','completed','cancelled')),
+  celebration_date date NOT NULL,
+  special_message  text,
+  grief_hold       boolean NOT NULL DEFAULT false,   -- navigator can hold if grief concern
+  navigator_note   text,
+  completed_at     timestamptz
+);
+
+CREATE INDEX IF NOT EXISTS celebration_requests_member_id_idx ON celebration_requests(member_id);
+CREATE INDEX IF NOT EXISTS celebration_requests_date_idx ON celebration_requests(celebration_date);
+
+ALTER TABLE celebration_requests ENABLE ROW LEVEL SECURITY;
+
+-- Family can create + see their own requests
+CREATE POLICY "cr_family_all" ON celebration_requests
+  FOR ALL USING (
+    member_id = ANY(acting_member_ids()) AND
+    requested_by IN (
+      SELECT id FROM family_members WHERE supabase_auth_id = auth.uid()
+    )
+  );
+
+-- Staff can see + update all
+CREATE POLICY "cr_staff_all" ON celebration_requests
+  FOR ALL USING (is_staff());
+
+-- ── celebration_messages ──────────────────────────────────────────────────────
+-- Family coordination messages (not visible to senior)
+
+CREATE TABLE IF NOT EXISTS celebration_messages (
+  id               uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at       timestamptz DEFAULT now() NOT NULL,
+  celebration_id   uuid NOT NULL REFERENCES celebration_requests(id) ON DELETE CASCADE,
+  sender_id        uuid NOT NULL REFERENCES family_members(id) ON DELETE CASCADE,
+  content          text NOT NULL CHECK (char_length(content) BETWEEN 1 AND 2000),
+  is_staff_message boolean NOT NULL DEFAULT false
+);
+
+CREATE INDEX IF NOT EXISTS cm_celebration_id_idx ON celebration_messages(celebration_id);
+
+ALTER TABLE celebration_messages ENABLE ROW LEVEL SECURITY;
+
+-- Family can read + write messages for celebrations they're part of
+CREATE POLICY "cm_family_all" ON celebration_messages
+  FOR ALL USING (
+    celebration_id IN (
+      SELECT id FROM celebration_requests
+      WHERE member_id = ANY(acting_member_ids())
+    )
+  );
+
+-- Staff can read + write all
+CREATE POLICY "cm_staff_all" ON celebration_messages
+  FOR ALL USING (is_staff());
diff --git a/supabase/migrations/113_volunteer_ecosystem_v2.sql b/supabase/migrations/113_volunteer_ecosystem_v2.sql
new file mode 100644
index 0000000..48e8537
--- /dev/null
+++ b/supabase/migrations/113_volunteer_ecosystem_v2.sql
@@ -0,0 +1,127 @@
+-- Migration 113: G7.7–G7.13 — Volunteer Ecosystem Completion
+-- Adds: university_partners, school_partners, professional specialty,
+--       neighbor volunteer category, zip-code enforcement, K-12 curriculum activities
+
+-- ── G7.7: University partners ─────────────────────────────────────────────────
+
+CREATE TABLE IF NOT EXISTS university_partners (
+  id                 uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at         timestamptz DEFAULT now() NOT NULL,
+  name               text NOT NULL,
+  slug               text NOT NULL UNIQUE,
+  contact_name       text NOT NULL,
+  contact_email      text NOT NULL,
+  active             boolean NOT NULL DEFAULT true,
+  semester_start     date,
+  semester_end       date,
+  hour_target        integer NOT NULL DEFAULT 40,    -- required service hours
+  enrolled_students  integer NOT NULL DEFAULT 0,
+  notes              text
+);
+
+ALTER TABLE university_partners ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "univ_staff_all" ON university_partners FOR ALL USING (is_staff());
+
+-- Link volunteers to university partner
+ALTER TABLE volunteers
+  ADD COLUMN IF NOT EXISTS university_partner_id uuid REFERENCES university_partners(id) ON DELETE SET NULL,
+  ADD COLUMN IF NOT EXISTS student_id_verified boolean NOT NULL DEFAULT false,
+  ADD COLUMN IF NOT EXISTS professional_specialty text;  -- e.g. 'attorney', 'cpa', 'physician', 'nurse', 'engineer'
+
+-- ── G7.8: VSO partner portals ─────────────────────────────────────────────────
+
+CREATE TABLE IF NOT EXISTS vso_partners (
+  id           uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at   timestamptz DEFAULT now() NOT NULL,
+  name         text NOT NULL,
+  slug         text NOT NULL UNIQUE,
+  affiliation  text NOT NULL,   -- maps to vso_affiliation enum values
+  contact_name text NOT NULL,
+  contact_email text NOT NULL,
+  active       boolean NOT NULL DEFAULT true
+);
+
+ALTER TABLE vso_partners ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "vso_staff_all" ON vso_partners FOR ALL USING (is_staff());
+
+-- ── G7.9: K-12 school partners + activity types ───────────────────────────────
+
+CREATE TABLE IF NOT EXISTS school_partners (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at      timestamptz DEFAULT now() NOT NULL,
+  name            text NOT NULL,
+  slug            text NOT NULL UNIQUE,
+  contact_name    text NOT NULL,
+  contact_email   text NOT NULL,
+  grade_band      text NOT NULL CHECK (grade_band IN ('k_5', '6_8', '9_12', 'mixed')),
+  active          boolean NOT NULL DEFAULT true,
+  student_count   integer NOT NULL DEFAULT 0
+);
+
+ALTER TABLE school_partners ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "school_staff_all" ON school_partners FOR ALL USING (is_staff());
+
+-- K-12 activity catalog (curated by grade band)
+CREATE TABLE IF NOT EXISTS youth_activity_types (
+  id           uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  grade_band   text NOT NULL CHECK (grade_band IN ('k_5', '6_8', '9_12')),
+  name         text NOT NULL,
+  description  text NOT NULL,
+  duration_minutes integer NOT NULL DEFAULT 60,
+  materials    text[],
+  active       boolean NOT NULL DEFAULT true
+);
+
+-- Seed K-12 activities
+INSERT INTO youth_activity_types (grade_band, name, description, duration_minutes)
+VALUES
+  ('k_5',  'Story Time Together',        'Student reads a picture book aloud to a senior and they discuss the story.', 30),
+  ('k_5',  'Art & Craft Exchange',       'Students and seniors create simple art together; swap finished pieces as keepsakes.', 60),
+  ('k_5',  'Letter Writing',             'Students write and decorate a letter for a senior pen pal.', 45),
+  ('6_8',  'Technology Help Session',    'Middle schoolers teach seniors to use smartphones, video calls, or email.', 60),
+  ('6_8',  'Oral History Interview',     'Students interview a senior about a historical event they lived through.', 60),
+  ('6_8',  'Garden & Nature Project',    'Students and seniors plant seeds together or work in a community garden.', 90),
+  ('9_12', 'Career Conversation',        'Senior shares career wisdom; student shares current interests and goals.', 45),
+  ('9_12', 'Service-Learning Reflection','Students document their service experience and share it with the senior.', 60),
+  ('9_12', 'Digital Life Review',        'Students help a senior create a digital photo album or family history document.', 90)
+ON CONFLICT DO NOTHING;
+
+-- ── G7.12: Neighbor volunteer category ────────────────────────────────────────
+
+-- Ensure volunteer_category column exists with neighbor option
+DO $$ BEGIN
+  ALTER TABLE volunteers ADD COLUMN IF NOT EXISTS volunteer_category text NOT NULL DEFAULT 'general';
+EXCEPTION WHEN others THEN NULL; END $$;
+
+-- Enforce zip-code match for neighbor volunteers (stored on volunteers table)
+ALTER TABLE volunteers
+  ADD COLUMN IF NOT EXISTS zip_code text,
+  ADD COLUMN IF NOT EXISTS background_check_required boolean NOT NULL DEFAULT true;
+
+-- Neighbor volunteers skip background check; navigator must approve each match
+CREATE TABLE IF NOT EXISTS neighbor_match_requests (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at      timestamptz DEFAULT now() NOT NULL,
+  volunteer_id    uuid NOT NULL REFERENCES volunteers(id) ON DELETE CASCADE,
+  member_id       uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  status          text NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','approved','declined','completed')),
+  navigator_note  text,
+  approved_by     uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  approved_at     timestamptz
+);
+
+ALTER TABLE neighbor_match_requests ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "nmr_staff_all" ON neighbor_match_requests FOR ALL USING (is_staff());
+CREATE POLICY "nmr_member_read" ON neighbor_match_requests FOR SELECT USING (member_id = ANY(acting_member_ids()));
+
+-- ── G7.13: Family reciprocity guard ──────────────────────────────────────────
+-- The guard that family volunteers NEVER match to their own senior is enforced in API.
+-- We add a helper index to make lookups fast.
+CREATE INDEX IF NOT EXISTS time_bank_credits_performed_for_idx
+  ON time_bank_credits(performed_for_member_id);
+
+-- ── Indexes ───────────────────────────────────────────────────────────────────
+CREATE INDEX IF NOT EXISTS volunteers_university_idx ON volunteers(university_partner_id);
+CREATE INDEX IF NOT EXISTS volunteers_category_idx ON volunteers(volunteer_category);
+CREATE INDEX IF NOT EXISTS volunteers_zip_idx ON volunteers(zip_code);
+CREATE INDEX IF NOT EXISTS volunteers_specialty_idx ON volunteers(professional_specialty);
diff --git a/supabase/migrations/114_sprint4_support_services.sql b/supabase/migrations/114_sprint4_support_services.sql
new file mode 100644
index 0000000..f34092b
--- /dev/null
+++ b/supabase/migrations/114_sprint4_support_services.sql
@@ -0,0 +1,99 @@
+-- Migration 114: Sprint 4 — Support & Services Depth
+-- G7.15 Facility-move planning workflow
+-- G7.16 Therapist/chaplain/grief counselor directory additions
+-- G7.21 Trusted advisor paid listings + 988/VITA
+
+-- ── G7.15: Facility-move planning ─────────────────────────────────────────
+
+CREATE TABLE IF NOT EXISTS transition_plans (
+  id               uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at       timestamptz DEFAULT now() NOT NULL,
+  member_id        uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  navigator_id     uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  plan_type        text NOT NULL DEFAULT 'facility_move'
+                   CHECK (plan_type IN ('facility_move','home_modification','downsizing','temporary_care','other')),
+  title            text NOT NULL DEFAULT 'Facility Move Plan',
+  started_at       timestamptz NOT NULL DEFAULT now(),
+  target_date      date,
+  status           text NOT NULL DEFAULT 'active'
+                   CHECK (status IN ('active','on_hold','completed','cancelled')),
+  family_can_see   boolean NOT NULL DEFAULT true,
+  notes            text
+);
+
+ALTER TABLE transition_plans ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "tp_member_read" ON transition_plans FOR SELECT
+  USING (member_id = ANY(acting_member_ids()) OR is_staff());
+CREATE POLICY "tp_staff_write" ON transition_plans FOR ALL USING (is_staff());
+-- Family sees plan when family_can_see=true
+CREATE POLICY "tp_family_read" ON transition_plans FOR SELECT
+  USING (family_can_see = true AND member_id = ANY(acting_member_ids()));
+
+CREATE TABLE IF NOT EXISTS transition_plan_steps (
+  id           uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at   timestamptz DEFAULT now() NOT NULL,
+  plan_id      uuid NOT NULL REFERENCES transition_plans(id) ON DELETE CASCADE,
+  step_number  integer NOT NULL,
+  week_number  integer NOT NULL DEFAULT 1,
+  title        text NOT NULL,
+  description  text NOT NULL,
+  due_date     date,
+  completed_at timestamptz,
+  completed_by uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  notes        text,
+  requires_transport boolean NOT NULL DEFAULT false,
+  transport_request_id uuid  -- FK to ride_bookings if exists
+);
+
+ALTER TABLE transition_plan_steps ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "tps_read" ON transition_plan_steps FOR SELECT
+  USING (
+    plan_id IN (
+      SELECT id FROM transition_plans
+      WHERE member_id = ANY(acting_member_ids()) OR is_staff()
+    )
+  );
+CREATE POLICY "tps_staff_write" ON transition_plan_steps FOR ALL USING (is_staff());
+
+-- ── G7.16: Trusted advisor category additions ──────────────────────────────
+
+-- Add columns to trusted_advisors if not already present
+ALTER TABLE trusted_advisors
+  ADD COLUMN IF NOT EXISTS license_number      text,
+  ADD COLUMN IF NOT EXISTS license_state       text,
+  ADD COLUMN IF NOT EXISTS telehealth_available boolean NOT NULL DEFAULT false,
+  ADD COLUMN IF NOT EXISTS non_proselytizing   boolean NOT NULL DEFAULT true,
+  ADD COLUMN IF NOT EXISTS chaplain_on_request_only boolean NOT NULL DEFAULT true;
+
+-- ── G7.21: Paid advisor listings ──────────────────────────────────────────
+
+CREATE TABLE IF NOT EXISTS trusted_advisor_listings (
+  id                 uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at         timestamptz DEFAULT now() NOT NULL,
+  trusted_advisor_id uuid NOT NULL REFERENCES trusted_advisors(id) ON DELETE CASCADE,
+  listing_tier       text NOT NULL CHECK (listing_tier IN ('basic','featured','premier')),
+  annual_fee_cents   integer NOT NULL,
+  stripe_sub_id      text UNIQUE,
+  paid_through_date  date,
+  status             text NOT NULL DEFAULT 'pending_approval'
+                     CHECK (status IN ('pending_approval','active','expired','cancelled')),
+  approved_by        uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  approved_at        timestamptz,
+  rejection_reason   text
+);
+
+ALTER TABLE trusted_advisor_listings ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "tal_staff_all" ON trusted_advisor_listings FOR ALL USING (is_staff());
+CREATE POLICY "tal_public_read" ON trusted_advisor_listings FOR SELECT
+  USING (status = 'active');
+
+-- Tier pricing reference (cents):
+-- basic:    240000  ($2,400/yr)
+-- featured: 360000  ($3,600/yr)
+-- premier:  600000  ($6,000/yr)
+
+-- ── Indexes ────────────────────────────────────────────────────────────────
+CREATE INDEX IF NOT EXISTS transition_plans_member_idx ON transition_plans(member_id);
+CREATE INDEX IF NOT EXISTS transition_plan_steps_plan_idx ON transition_plan_steps(plan_id, step_number);
+CREATE INDEX IF NOT EXISTS tal_advisor_idx ON trusted_advisor_listings(trusted_advisor_id);
+CREATE INDEX IF NOT EXISTS tal_status_idx ON trusted_advisor_listings(status);
diff --git a/supabase/migrations/115_sprint5_culture_pets_addons.sql b/supabase/migrations/115_sprint5_culture_pets_addons.sql
new file mode 100644
index 0000000..a859f08
--- /dev/null
+++ b/supabase/migrations/115_sprint5_culture_pets_addons.sql
@@ -0,0 +1,170 @@
+-- Migration 115: Sprint 5 — Cultural Programming · Premium Add-ons · Pet Profiles
+-- G7.22 Cultural programming depth
+-- G7.23 Premium add-on SKUs
+-- G7.24 Pet profiles + milestones
+
+-- ── G7.22: Cultural programming ───────────────────────────────────────────
+
+CREATE TABLE IF NOT EXISTS cultural_festivals (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at      timestamptz DEFAULT now() NOT NULL,
+  name            text NOT NULL,
+  description     text,
+  cultural_group  text NOT NULL,   -- e.g. 'chinese', 'jewish', 'hispanic', 'irish', 'african_american', 'indian', 'muslim', 'generic'
+  month           integer NOT NULL CHECK (month BETWEEN 1 AND 12),
+  day             integer CHECK (day BETWEEN 1 AND 31),  -- null = date varies by year
+  is_active       boolean NOT NULL DEFAULT true,
+  aria_script_key text    -- optional: reference to Aria script variant for this festival
+);
+
+ALTER TABLE cultural_festivals ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "cf_public_read" ON cultural_festivals FOR SELECT USING (is_active = true);
+CREATE POLICY "cf_staff_write" ON cultural_festivals FOR ALL USING (is_staff());
+
+CREATE TABLE IF NOT EXISTS member_cultural_interests (
+  id           uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at   timestamptz DEFAULT now() NOT NULL,
+  member_id    uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  cultural_tag text NOT NULL,
+  UNIQUE (member_id, cultural_tag)
+);
+
+ALTER TABLE member_cultural_interests ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "mci_member_rw" ON member_cultural_interests FOR ALL
+  USING (member_id = ANY(acting_member_ids()) OR is_staff());
+
+CREATE TABLE IF NOT EXISTS community_potlucks (
+  id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at      timestamptz DEFAULT now() NOT NULL,
+  title           text NOT NULL,
+  description     text,
+  cultural_theme  text,
+  event_date      date NOT NULL,
+  event_time      time,
+  location        text,
+  max_attendees   integer,
+  organizer_id    uuid REFERENCES members(id) ON DELETE SET NULL,
+  status          text NOT NULL DEFAULT 'upcoming' CHECK (status IN ('upcoming','cancelled','completed')),
+  dish_signups    jsonb NOT NULL DEFAULT '[]'::jsonb  -- [{member_id, dish, dietary_tags}]
+);
+
+ALTER TABLE community_potlucks ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "pot_read" ON community_potlucks FOR SELECT USING (status != 'cancelled' OR is_staff());
+CREATE POLICY "pot_staff_write" ON community_potlucks FOR ALL USING (is_staff());
+
+CREATE TABLE IF NOT EXISTS oral_history_entries (
+  id            uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at    timestamptz DEFAULT now() NOT NULL,
+  member_id     uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  title         text NOT NULL,
+  story_text    text NOT NULL,
+  recorded_at   date NOT NULL DEFAULT CURRENT_DATE,
+  decade        text,          -- e.g. '1950s', '1960s'
+  themes        text[],        -- e.g. ['family','immigration','work','war']
+  is_public     boolean NOT NULL DEFAULT false,   -- shared with village community
+  approved_by   uuid REFERENCES family_members(id) ON DELETE SET NULL,
+  voice_note_url text                              -- future: Retell audio
+);
+
+ALTER TABLE oral_history_entries ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "ohe_member_rw" ON oral_history_entries FOR ALL
+  USING (member_id = ANY(acting_member_ids()) OR is_staff());
+CREATE POLICY "ohe_public_read" ON oral_history_entries FOR SELECT
+  USING (is_public = true AND approved_by IS NOT NULL);
+
+-- ── G7.23: Premium add-on SKUs ─────────────────────────────────────────────
+
+-- Add-ons are tied to members via member_plan_addons
+-- SKUs:
+--   family_onboarding    $29 one-time
+--   navigator_hour       $25/hr (sold in 1-hr blocks)
+--   companion_bundle     $100/mo
+--   cosigned_card        $9.99/mo
+
+CREATE TABLE IF NOT EXISTS addon_skus (
+  id               uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  sku              text NOT NULL UNIQUE,
+  name             text NOT NULL,
+  description      text,
+  price_cents      integer NOT NULL,
+  billing_type     text NOT NULL CHECK (billing_type IN ('one_time','monthly','per_unit')),
+  is_active        boolean NOT NULL DEFAULT true,
+  stripe_price_id  text
+);
+
+-- Seed SKUs
+INSERT INTO addon_skus (sku, name, description, price_cents, billing_type) VALUES
+  ('family_onboarding', 'Family Onboarding', 'Guided onboarding session for family members — setup, training, and first navigator call', 2900, 'one_time'),
+  ('navigator_hour', 'Navigator Hour', 'One hour of dedicated navigator time for complex tasks, care coordination, or research', 2500, 'per_unit'),
+  ('companion_bundle', 'Companion Bundle', 'Enhanced daily companion calls + priority routing + personalized conversation memory', 10000, 'monthly'),
+  ('cosigned_card', 'Co-Signed Card', 'Family-cosigned prepaid card for member independence with spending alerts', 999, 'monthly')
+ON CONFLICT (sku) DO NOTHING;
+
+CREATE TABLE IF NOT EXISTS member_addons (
+  id                 uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at         timestamptz DEFAULT now() NOT NULL,
+  member_id          uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  sku                text NOT NULL REFERENCES addon_skus(sku),
+  status             text NOT NULL DEFAULT 'active' CHECK (status IN ('active','cancelled','expired')),
+  quantity           integer NOT NULL DEFAULT 1,    -- for per_unit SKUs
+  stripe_sub_id      text,
+  stripe_payment_id  text,
+  paid_through_date  date,
+  activated_at       timestamptz DEFAULT now(),
+  cancelled_at       timestamptz,
+  requested_by       uuid REFERENCES family_members(id) ON DELETE SET NULL
+);
+
+ALTER TABLE member_addons ENABLE ROW LEVEL SECURITY;
+CREATE POLICY "ma_member_read" ON member_addons FOR SELECT
+  USING (member_id = ANY(acting_member_ids()) OR is_staff());
+CREATE POLICY "ma_staff_write" ON member_addons FOR ALL USING (is_staff());
+
+-- ── G7.24: Pet profiles + milestones ──────────────────────────────────────
+
+CREATE TABLE IF NOT EXISTS member_pets (
+  id            uuid DEFAULT gen_random_uuid() PRIMARY KEY,
+  created_at    timestamptz DEFAULT now() NOT NULL,
+  member_id     uuid NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+  name          text NOT NULL,
