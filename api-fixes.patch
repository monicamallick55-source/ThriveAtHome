+        return
+      }
+      const { post } = await res.json() as { post: CirclePost }
+      onPosted({ ...post, members: { preferred_name: currentMember.preferred_name, full_name: currentMember.full_name } })
+      setDraft('')
+    } finally {
+      setSubmitting(false)
+    }
+  }
+
+  const remaining = 2000 - draft.length
